# RealitySim 后端环境配置
PORT=3000
JWT_SECRET=realitysim-dev-secret-change-me
JWT_EXPIRES=7d
CORS_ORIGIN=*
# 公网/本地基础地址（OAuth 回调、验证码跳转用）
PUBLIC_BASE_URL=http://localhost:3000

# 内置管理员
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456
ADMIN_NICKNAME=管理员

# 开发模式：验证码直接随接口返回（生产务必设为 false）
DEV_MODE=true
# 第三方 OAuth 开发联调模拟（未申请开放平台应用时可联调全流程）
OAUTH_DEV_MOCK=true

# ===== 第三方开放平台配置（在对应平台申请后填写并重启）=====
# 微信开放平台（网站应用）：https://open.weixin.qq.com
WECHAT_CLIENT_ID=
WECHAT_CLIENT_SECRET=
WECHAT_REDIRECT_URI=

# QQ互联（网站应用）：https://connect.qq.com
QQ_CLIENT_ID=
QQ_CLIENT_SECRET=
QQ_REDIRECT_URI=

# 抖音开放平台（网站应用）：https://open.douyin.com
DOUYIN_CLIENT_KEY=
DOUYIN_CLIENT_SECRET=
DOUYIN_REDIRECT_URI=

# 微软 Azure AD（个人可自助申请）：https://portal.azure.com
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=

# ===== 验证码发送通道（生产必须配置）=====
# 短信（阿里云短信为例）
SMS_PROVIDER=
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=
# 邮件（SMTP）
MAIL_HOST=
MAIL_PORT=465
MAIL_USER=
MAIL_PASS=
