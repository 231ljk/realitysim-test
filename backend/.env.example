# 现实模拟 RealitySim 后端环境配置
# 复制为 .env 后按需修改

# 服务端口
PORT=3000

# JWT 密钥（生产环境务必改成强随机串，可用: openssl rand -hex 32）
JWT_SECRET=realitysim-dev-secret-change-me
JWT_EXPIRES=7d

# 数据库文件路径（相对项目根目录）
DB_PATH=data/realitysim.db

# 上传文件保存目录
UPLOAD_DIR=uploads

# 允许的跨域来源（前端网页地址，多个用逗号分隔）
CORS_ORIGIN=http://localhost:8080,https://231ljk.github.io

# 对外访问根地址（用于拼出图片/语音的完整 URL；留空则用请求 Host 自动拼接）
PUBLIC_BASE_URL=

# 预留：Casdoor 账号系统对接（启用后 JWT 校验交给 Casdoor）
# CASDOOR_ENDPOINT=
# CASDOOR_CLIENT_ID=
# CASDOOR_CLIENT_SECRET=
# CASDOOR_JWT_PUBLIC_KEY=
